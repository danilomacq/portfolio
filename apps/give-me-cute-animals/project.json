{
  "name": "give-me-cute-animals",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/give-me-cute-animals/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "baseHref": "/give-me-cute-animals/",
        "outputPath": "dist/apps/give-me-cute-animals",
        "index": "apps/give-me-cute-animals/src/index.html",
        "browser": "apps/give-me-cute-animals/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/give-me-cute-animals/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/give-me-cute-animals/public"
          }
        ],
        "styles": [
          "apps/give-me-cute-animals/src/styles/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "give-me-cute-animals:build:production"
        },
        "development": {
          "buildTarget": "give-me-cute-animals:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4300
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "give-me-cute-animals:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/give-me-cute-animals/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "give-me-cute-animals:build",
        "port": 4200,
        "staticFilePath": "dist/apps/give-me-cute-animals/browser",
        "spa": true
      }
    }
  }
}